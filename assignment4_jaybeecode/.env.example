# Copy to .env and fill in. .env is gitignored, never commit it.

# Postgres (used by docker-compose, the extractor and dbt)
DB_HOST=localhost
DB_PORT=5434
DB_USER=analytics
DB_PASS=change_me
DB_NAME=uniswap

# Optional: only needed to re-extract fresh data from Ethereum (--source rpc).
# The default run loads the committed snapshot and needs no RPC.
WEB3_RPC_URL=https://eth.drpc.org
